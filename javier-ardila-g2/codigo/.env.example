# Configuracion de ejemplo (NO subir el .env real)
PRICING_SERVICE_URL=http://pricing-service:8001

# Reglas de asignacion (Fase 1)
SAME_ZONE_PREFERRED=true
CAPACITY_CHECK=true
LEAST_LOADED=true

# Control de rafagas (Fase 2)
RATE_LIMIT_ENABLED=true
MAX_ORDERS_PER_WINDOW=3
RATE_WINDOW_SECONDS=10

# Contencion
CONTAINMENT_ENABLED=true
CONTAINMENT_THRESHOLD=3
CONTAINMENT_DURATION_SECONDS=120

# Circuit breaker (Fase 3)
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_OPEN_DURATION_SECONDS=15

# Pricing
BASE_RATE_COP=3000
PER_KM_RATE_COP=1000
PRICING_FAILURE_RATE=0.3
